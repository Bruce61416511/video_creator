# ================== 依赖（本地 install 重建，不入库）==================
node_modules/
venv/
.venv/

# ================== 编译 / 打包缓存 ==================
__pycache__/
*.pyc
*.pyo
*.pyd
frontend/dist/
frontend/node_modules/.vite/

# ================== 运行时产物 ==================
backend/uploads/
backend/output/
backend/cookies/
backend/screenshots/
backend/*.log
backend/data.db
backend/*.sqlite

# 合并 / 导出的视频（运行时产物，不入库）
backend/*.mp4
backend/**/*.mp4

# moviepy 写视频时的临时音轨文件（正常会自动删除，进程被中断会残留）
# 例：backend/merged_a91fca3eTEMP_MPY_wvf_snd.mp4
**/TEMP_MPY*
TEMP_MPY*

# 本地备份文件（如手工改配置前的 .bak）
*.bak

# ================== 环境 / 敏感 ==================
.env
*.env
.env.*
# 配置模板里不含密钥，需要入库（否则新环境不知道要配哪些变量）
!.env.production.example

# ================== 部署相关 ==================
# docker compose 的数据目录（上传文件与运行时配置在宿主机的落点）
data/
# 改动前的安全备份目录（由 .deploy/backup.py 生成）
.backup-*/

# ================== 仅限本地：绝不要提交 ==================
# ⚠️ 本仓库是【公开仓库】。以下内容含服务器内网信息 / 密钥 / 部署细节，
#    一旦提交等于对外公开，请勿移除这些规则。
#
# .deploy/ 内含 wan-video.tar.gz（压缩包里有 backend/.env，即真实 API Key），
#          还有 _netinfo.txt（本机内网拓扑）、各类调试日志。
.deploy/
#
# WorkBuddy 助手的工作记忆，含服务器 IP、路径、运维细节。
.workbuddy/
#
# 以下三份文档记录了真实服务器 IP / 蒲公英虚拟网段 / 全部对外服务清单，
# 相当于一张内部网络地图，只保留在本地。
DEPLOY-NATIVE.md
SERVER-SERVICES.md
智能体导航台.html

# 模型配置：改为一并入库（已核实文件内不含任何密钥，只有模型 ID / 默认参数 / LLM 接入地址），
# 否则新环境 git clone 下来会缺这个文件导致后端起不来。真正的密钥在 .env 里，仍保持忽略。
# backend/config/models.json  ← 故意不忽略

# 临时脚本（下划线前缀 = 一次性调试/迁移脚本，不入库）
backend/_*.py

# ================== 系统 ==================
.DS_Store
Thumbs.db
desktop.ini

# ================== 编辑器 ==================
.vscode/
.idea/
*.swp
